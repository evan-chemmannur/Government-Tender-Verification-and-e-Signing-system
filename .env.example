# eSignet / OIDC
CLIENT_ID=
ESIGNET_BASE_URL=https://sandbox.esignet.io
ESIGNET_AUTHORIZE_ENDPOINT=
ESIGNET_TOKEN_ENDPOINT=
ESIGNET_USERINFO_ENDPOINT=
ESIGNET_JWKS_URI=
REDIRECT_URI=http://localhost:3000/auth/callback
PRIVATE_KEY_PATH=./keys/oidc-private.pem
KID=
ACR_VALUES=mosip:idp:acr:generated-code

# Database
DATABASE_URL=postgresql://tender_app:tender_password@localhost:5432/tender_portal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tender_portal
DB_USER=tender_app
DB_PASSWORD=tender_password

# Session
SESSION_SECRET=super_secret_session_key_replace_me_in_prod

# Inji Certify
INJI_CERTIFY_BASE_URL=
INJI_CLIENT_ID=
INJI_CLIENT_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug
